      "id": "PLAN_TERMINAL_CANCEL",
      "priority": "P2",
      "source": "services/agent.py:147-150拒turn.status.is_terminal；models/tool_run.py:21-22定义succeeded/failed/canceled终态；routers/sessions.py:273-282返回409",
