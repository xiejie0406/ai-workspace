    "/internal/paiflow/v1/runs/{runId}/resources/{resourceId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "name": "resourceId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      ],
      "post": {
        "operationId": "modelResource",
        "description": "当前模型资源仅公开六字段，按当前租约及固定版本授权；私有endpoint/引用不出现在assignment或本响应。其他资源种类由所属能力另行实现。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "model-operations.schema.json#/$defs/LeaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AjaxResult code=200/data，完整绑定及停止/尾帧仍须严格核对",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "model-operations.schema.json#/$defs/OpenAIChatSnapshot"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "未知字段/非法类型/游标/参数"
