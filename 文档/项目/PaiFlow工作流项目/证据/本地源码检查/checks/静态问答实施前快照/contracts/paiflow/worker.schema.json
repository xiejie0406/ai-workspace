{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paiflow:worker:v1",
  "title": "PaiFlow中心派发任务",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "workflowVersionId",
    "dslHash",
    "engineProfile",
    "input",
    "resourceSnapshots",
    "attempt",
    "leaseId",
    "deadline",
    "effectPolicy",
    "dsl",
    "lastEventSeq",
    "dslCanonicalBase64"
  ],
  "properties": {
    "schemaVersion": {
      "const": "paiflow.worker.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "workflowVersionId": {
      "type": "string",
      "minLength": 1
    },
    "dslHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engineProfile": {
      "enum": [
        "java",
        "python"
      ]
    },
    "input": {
      "type": "object"
    },
    "resourceSnapshots": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "leaseId": {
      "type": "string",
      "minLength": 1
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowedOperations"
      ],
      "properties": {
        "mode": {
          "enum": [
            "read_only",
            "approved_write"
          ]
        },
        "allowedOperations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "approved_write"
              }
            }
          },
          "then": {
            "required": [
              "approvalRef"
            ]
          }
        }
      ]
    },
    "dsl": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "data"
            ]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceNodeId",
              "targetNodeId"
            ]
          }
        }
      }
    },
    "lastEventSeq": {
      "type": "integer",
      "minimum": 0
    },
    "dslCanonicalBase64": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "base64",
      "$comment": "中心DslCodec规范化UTF-8 JSON字节；Worker解码原字节做SHA256，并核对解码后的图与dsl相等，不重新JSON序列化计算哈希。"
    }
  },
  "$comment": "中心保存正式任务/租约/事件与一次性执行登记；真实联机/资源端点仍未完整验证。verify仅核对快照，进入原引擎前必须获得execution/begin首次完整ACK；任何重复/丢失/未知ACK均不得执行或提交终态。dslHash使用中心DslCodec规范化执行图；资源和凭据只能由中心按运行范围提供。",
  "$defs": {
    "ExecutionBeginAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["begun", "runId", "leaseId", "attempt", "workflowVersionId", "dslHash"],
      "properties": {
        "begun": {"const": true},
        "runId": {"$ref": "#/properties/runId"},
        "leaseId": {"$ref": "#/properties/leaseId"},
        "attempt": {"$ref": "#/properties/attempt"},
        "workflowVersionId": {"$ref": "#/properties/workflowVersionId"},
        "dslHash": {"$ref": "#/properties/dslHash"}
      },
      "$comment": "只有首次行锁/CAS登记成功返回。重复请求409；不得把ACK丢失变成可重试许可，登记本身不证明节点执行或外部副作用完成。"
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "attempt",
        "state"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "EFFECT_UNKNOWN"
          ]
        },
        "output": {},
        "error": {
          "type": "object"
        }
      }
    },
    "LeaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "attempt"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
