  "originalIdentityChain": [
    {
      "source": "参考项目/PaiFlow-main/console/backend/toolkit/src/main/java/com/iflytek/astron/console/toolkit/config/properties/CommonConfig.java",
      "lines": [
        8,
        15
      ],
      "fact": "common配置声明appId/apiKey/apiSecret；本次只读声明，不读真实值。它是默认后台应用来源，不是AgentId。"
    },
    {
      "source": "参考项目/PaiFlow-main/console/backend/toolkit/src/main/java/com/iflytek/astron/console/toolkit/service/workflow/WorkflowService.java",
      "lines": [
        1015,
        1054
      ],
      "fact": "原create无条件setAppId(commonConfig.getAppId())，callProtocolAdd后将原Core返回flow_id保存Workflow.flowId；原本地Workflow.id、flowId、uid、spaceId各自独立。"
    },
    {
      "source": "参考项目/PaiFlow-main/console/backend/toolkit/src/main/java/com/iflytek/astron/console/toolkit/service/workflow/WorkflowService.java",
      "lines": [
        1734,
        1753
      ],
      "fact": "protocol/add body.app_id来自WorkflowReq.appId，返回Core db_flow.id字符串作为flowId。不能把本地自增Workflow.id当CoreflowID。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/api/v1/flow/layout.py",
      "lines": [
        41,
        80
      ],
      "fact": "Core add以flow.app_id给Span，app_service.get_info获取App，再flow_service.save；回执flow_id是实际db_flow.id。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/service/flow_service.py",
      "lines": [
        44,
        70
      ],
      "fact": "Core Flow存独立id/group_id、app_id为应用别名、source来自App.actual_source、草稿version=-1；group_id用于后续发布版本/license关系，不是变量scope中的App或flow替代。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/domain/models/ai_app.py",
      "fact": "App.id为内部雪花主键，alias_id是外部业务App标识；有status/source/actual_source及凭据字段。GlobalVariablesNode使用Span.app_id即alias_id，不是App内部id。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/service/app_service.py",
      "lines": [
        149,
        218
      ],
      "fact": "get_info先App cache再按alias_id读DB；缺记录分支目前有硬编码source/name/desc/凭据占位并插入App。该fallback不是已核实真实Tenant回执，不应迁为默认成功实现。",
      "constantFallbackFieldNamesOnly": [
        "api_key",
        "api_secret",
        "desc",
        "name",
        "source_id"
      ]
    },
    {
      "source": "参考项目/PaiFlow-main/console/backend/toolkit/src/main/java/com/iflytek/astron/console/toolkit/service/workflow/WorkflowService.java",
      "lines": [
        3095,
        3132
      ],
      "fact": "原debug chat查实际Workflow并取该appId凭据，X-Consumer-Username=Workflow.appId；Core请求flow_id来自同一Workflow，uid来自当前UserInfoManager，parameters来自本次inputs。nodeParam.appId不是变量scope的直接来源。"
    },
    {
      "source": "参考项目/PaiFlow-main/console/backend/toolkit/src/main/java/com/iflytek/astron/console/toolkit/entity/core/workflow/sse/ChatSysReq.java",
      "lines": [
        35,
        48
      ],
      "fact": "chatId为nullable String，无默认值。Toolkit3118-3124只在有效多轮历史时调用buildParams，3246才setChatId；否则NON_NULL省略chat_id，Core ChatVo默认空串。原页面SSE关联chatId不能不经核对直接变成变量chat scope。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/api/v1/chat/debug.py",
      "lines": [
        32,
        68
      ],
      "fact": "Coreapp_id=可信网关header的x_consumer_username，Span同时用ChatVo.uid/chat_id；再查App信息。原发布open路径同样以header App给Span，但另要求publishedflow/license。迁移不再信任用户自由指定uid/App header。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/service/chat_service.py",
      "lines": [
        512,
        531
      ],
      "fact": "正式执行把chat_vo.flow_id设为ParamKey.FlowId。Engine Factory只解析/构造节点，不产生应用或用户身份。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/engine/entities/variable_pool.py",
      "lines": [
        466,
        485
      ],
      "fact": "原Start输入写入时把span.chat_id复制给VariablePool.chat_id。"
    },
    {
      "source": "参考项目/PaiFlow-main/core/workflow/engine/nodes/global_variables/global_variables_node.py",
      "lines": [
        153,
        171
      ],
      "fact": "变量tuple严格取FlowId systemparam、Span.uid/app_id、pool.chat_id；不取nodeParam appId、Workflow版本、BotId、RunId。"
    }
  ],
