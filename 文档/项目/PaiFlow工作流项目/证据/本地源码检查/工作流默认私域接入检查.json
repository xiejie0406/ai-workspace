    {
      "routes": "POST /workflow; DELETE /workflow",
      "original": "create只body.spaceId；delete只query.spaceId",
      "current": "保留已授权中心header fallback，使原只header页面调用在具名域可用；显式body/query正ID仍优先并真实授权"
    },
    {
      "routes": "GET /workflow/clone",
      "rule": "原header选择；中心existing只读，callback之前禁止materialize/Space写锁，Agent先creatorGuard"
    },
    {
      "routes": "GET /workflow/version/list; POST /workflow/version; POST /workflow/version/restore; POST /workflow/version/get-version-name",
      "rule": "header唯一选择；body仅一致echo，不能提升默认为空header到named"
