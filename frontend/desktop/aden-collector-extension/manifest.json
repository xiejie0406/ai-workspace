{
  "manifest_version": 3,
  "name": "Aden 商品采集（开发版）",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "nativeMessaging", "alarms"],
  "optional_host_permissions": ["https://item.jd.com/*", "https://img10.360buyimg.com/*", "https://img11.360buyimg.com/*", "https://img12.360buyimg.com/*", "https://img13.360buyimg.com/*", "https://img14.360buyimg.com/*", "https://img30.360buyimg.com/*"],
  "background": {"service_worker":"background.js", "type":"module"},
  "action": {"default_title":"打开 Aden 商品采集并授权当前页"},
  "side_panel": {"default_path":"panel.html"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'"}
}
