{
  "schemaVersion": 1,
  "contractVersion": "1.2.0",
  "scope": "FEAT-ADEN-001 CORE 与 FEAT-ADEN-003 用户触发COL；必须协调升级严格枚举消费者",
  "terms": {
    "workspace": "Operator 授权、Task、Runner、Event 与 Audit 的资源隔离根",
    "operator": "经 RuoYi JWT 认证并同时受 aden:* 权限与 Workspace membership 约束的人类主体",
    "runner": "使用独立设备凭据与短期 Session 的低权限执行模拟器",
    "agentWorker": "未来独立机器身份；current OpenAPI 不发布",
    "streamCursor": "绑定 workspace、Schema、filter、after-sequence 与到期时间的 MAC 不透明游标",
    "fencingToken": "每次 Delivery 重新领取单调递增、阻止旧 owner 回执的十进制字符串"
  },
  "identities": {
    "external": [
      "OPERATOR",
      "RUNNER",
      "AGENT_WORKER"
    ],
    "internalActors": [
      "VALIDATOR",
      "COORDINATOR",
      "RUNNER_RECEIPT_ADAPTER",
      "COLLECTOR"
    ]
  },
  "taskStates": [
    "DRAFT",
    "VALIDATING",
    "QUEUED",
    "RUNNING",
    "WAITING_USER",
    "WAITING_EXTERNAL",
    "CANCEL_REQUESTED",
    "SUCCEEDED",
    "FAILED",
    "CANCELED"
  ],
  "publicOperatorCommands": {
    "SUBMIT_FOR_VALIDATION": "aden:task:command",
    "REQUEST_CANCEL": "aden:task:cancel"
  },
  "internalCommands": [
    "VALIDATION_PASSED",
    "VALIDATION_FAILED",
    "START",
    "PROGRESS",
    "COMPLETE",
    "FAIL",
    "WAIT_FOR_USER",
    "WAIT_FOR_EXTERNAL",
    "RESUME",
    "CONFIRM_CANCELED"
  ],
  "stateActorCommand": [
    {
      "from": "DRAFT",
      "actor": "OPERATOR",
      "command": "SUBMIT_FOR_VALIDATION",
      "to": "VALIDATING"
    },
    {
      "from": "VALIDATING",
      "actor": "VALIDATOR",
      "command": "VALIDATION_PASSED",
      "to": "QUEUED"
    },
    {
      "from": "VALIDATING",
      "actor": "VALIDATOR",
      "command": "VALIDATION_FAILED",
      "to": "FAILED"
    },
    {
      "from": "QUEUED",
      "actor": "RUNNER_RECEIPT_ADAPTER",
      "command": "START",
      "to": "RUNNING"
    },
    {
      "from": "QUEUED",
      "actor": "OPERATOR",
      "command": "REQUEST_CANCEL",
      "to": "CANCEL_REQUESTED"
    },
    {
      "from": "RUNNING",
      "actor": "RUNNER_RECEIPT_ADAPTER",
      "command": "PROGRESS",
      "to": "RUNNING"
    },
    {
      "from": "RUNNING",
      "actor": "RUNNER_RECEIPT_ADAPTER",
      "command": "COMPLETE",
      "to": "SUCCEEDED"
    },
    {
      "from": "RUNNING",
      "actor": "RUNNER_RECEIPT_ADAPTER",
      "command": "FAIL",
      "to": "FAILED"
    },
    {
      "from": "RUNNING",
      "actor": "OPERATOR",
      "command": "REQUEST_CANCEL",
      "to": "CANCEL_REQUESTED"
    },
    {
      "from": "WAITING_USER",
      "actor": "OPERATOR",
      "command": "REQUEST_CANCEL",
      "to": "CANCEL_REQUESTED"
    },
    {
      "from": "WAITING_EXTERNAL",
      "actor": "OPERATOR",
      "command": "REQUEST_CANCEL",
      "to": "CANCEL_REQUESTED"
    },
    {
      "from": "CANCEL_REQUESTED",
      "actor": "RUNNER_RECEIPT_ADAPTER",
      "command": "CONFIRM_CANCELED",
      "to": "CANCELED"
    },
    {
      "from": "CANCEL_REQUESTED",
      "actor": "COORDINATOR",
      "command": "CONFIRM_CANCELED",
      "to": "CANCELED",
      "condition": "no-active-delivery"
    },
    {
      "from": "QUEUED",
      "actor": "COLLECTOR",
      "command": "START",
      "to": "RUNNING"
    },
    {
      "from": "RUNNING",
      "actor": "COLLECTOR",
      "command": "COMPLETE",
      "to": "SUCCEEDED"
    },
    {
      "from": "RUNNING",
      "actor": "COLLECTOR",
      "command": "FAIL",
      "to": "FAILED"
    }
  ],
  "wireScalars": {
    "int64DecimalString": {
      "minimum": "0",
      "maximum": "9223372036854775807",
      "canonical": true,
      "fields": [
        "task/version",
        "event/aggregateVersion",
        "event/sequence",
        "runner/credentialEpoch",
        "runner/sessionEpoch",
        "delivery/fencingToken",
        "receipt/receiptSequence",
        "publicRuoYiBigintId"
      ]
    },
    "int32Bounded": [
      "attemptNo",
      "capacity",
      "batchLimit",
      "progressPercent"
    ],
    "opaque": [
      "ETag",
      "streamCursor",
      "pageCursor"
    ]
  },
