{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aden current common wire types",
  "$defs": {
    "CanonicalInt64String": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|(?:[1-8][0-9]{18}|9(?:[0-1][0-9]{17}|2(?:[0-1][0-9]{16}|2(?:[0-2][0-9]{15}|3(?:[0-2][0-9]{14}|3(?:[0-6][0-9]{13}|7(?:[0-1][0-9]{12}|2(?:0(?:[0-2][0-9]{10}|3(?:[0-5][0-9]{9}|6(?:[0-7][0-9]{8}|8(?:[0-4][0-9]{7}|5(?:[0-3][0-9]{6}|4(?:[0-6][0-9]{5}|7(?:[0-6][0-9]{4}|7(?:[0-4][0-9]{3}|5(?:[0-7][0-9]{2}|8(?:0[0-7])))))))))))))))))))$",
      "description": "Canonical base-10 string in 0..Long.MAX_VALUE; never convert through JavaScript number.",
      "examples": ["0", "9007199254740991", "9007199254740992", "9223372036854775807"]
    },
    "Uuid": {"type": "string", "format": "uuid"},
    "UtcDateTime": {"type": "string", "format": "date-time"},
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "CorrelationId": {"$ref": "#/$defs/Uuid"},
    "IdempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "StreamCursor": {
      "type": "string",
      "minLength": 24,
      "maxLength": 768,
      "pattern": "^aden-c1\\.[A-Za-z0-9_-]+$"
    },
    "PageCursor": {
      "type": "string",
      "minLength": 16,
      "maxLength": 768,
      "pattern": "^aden-p1\\.[A-Za-z0-9_-]+$"
    },
    "CapabilityCode": {"type": "string", "enum": ["CORE", "WX", "PUR", "COL"]},
    "WorkspaceRole": {"type": "string", "enum": ["OWNER", "OPERATOR", "VIEWER"]},
    "WorkspaceStatus": {"type": "string", "enum": ["ACTIVE", "SUSPENDED"]},
    "TaskState": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATING", "QUEUED", "RUNNING", "WAITING_USER", "WAITING_EXTERNAL", "CANCEL_REQUESTED", "SUCCEEDED", "FAILED", "CANCELED"]
    },
    "TaskStepState": {
      "type": "string",
      "enum": ["PENDING", "READY", "RUNNING", "WAITING_RETRY", "SUCCEEDED", "FAILED", "CANCELED", "OUTCOME_UNKNOWN"]
    },
    "OperatorTaskCommand": {
      "type": "string",
      "enum": ["SUBMIT_FOR_VALIDATION", "REQUEST_CANCEL"]
    },
    "RunnerPresence": {"type": "string", "enum": ["ONLINE", "OFFLINE", "LEASED", "QUARANTINED"]},
    "RunnerSessionState": {"type": "string", "enum": ["ACTIVE", "EXPIRED", "REVOKED", "SUPERSEDED", "CLOSED"]},
    "DeliveryState": {"type": "string", "enum": ["READY", "LEASED", "RUNNING", "COMPLETED", "FAILED_RETRYABLE", "FAILED_FINAL", "CANCELED", "OUTCOME_UNKNOWN"]},
    "ErrorCode": {
      "type": "string",
      "enum": [
        "ADEN_INVALID_ARGUMENT", "ADEN_STREAM_CURSOR_INVALID", "ADEN_AUTH_REQUIRED",
        "ADEN_RUNNER_AUTH_INVALID", "ADEN_PERMISSION_DENIED", "ADEN_EXTERNAL_ACTION_DISABLED",
        "ADEN_TASK_NOT_FOUND", "ADEN_RUNNER_NOT_FOUND", "ADEN_STATE_TRANSITION_DENIED", "ADEN_DEFAULT_WORKSPACE_UNAVAILABLE",
        "ADEN_IDEMPOTENCY_KEY_REUSED", "ADEN_RUNNER_LEASE_LOST", "ADEN_SESSION_EPOCH_STALE",
        "ADEN_RECEIPT_STALE", "ADEN_OUTCOME_UNKNOWN", "ADEN_STREAM_CURSOR_EXPIRED",
        "ADEN_VERSION_CONFLICT", "ADEN_TASK_VALIDATION_FAILED", "ADEN_PRECONDITION_REQUIRED",
        "ADEN_RATE_LIMITED", "ADEN_DEPENDENCY_UNAVAILABLE", "ADEN_AUDIT_UNAVAILABLE"
      ]
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "msg", "data", "errorCode", "retryable", "correlationId"],
      "properties": {
        "code": {"type": "integer", "enum": [400, 401, 403, 404, 409, 410, 412, 422, 428, 429, 503]},
        "msg": {"type": "string", "minLength": 1, "maxLength": 512},
        "data": {"type": "null"},
        "errorCode": {"$ref": "#/$defs/ErrorCode"},
        "retryable": {"type": "boolean"},
        "correlationId": {"$ref": "#/$defs/CorrelationId"},
        "details": {
          "type": "object",
          "additionalProperties": {"type": ["string", "integer", "boolean", "null"]},
          "maxProperties": 16
        }
      }
    }
  }
}
