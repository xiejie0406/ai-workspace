  "description": "PPT 的统一内容模型。\n\n内容、布局、主题三者分离：这里描述页面块内容；\nfixed 页几何来自布局槽位，flex 页几何来自 layout_tree，视觉表现来自主题。",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "theme_id": {
      "title": "Theme Id",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/Slide"
      },
      "title": "Slides",
      "type": "array",
      "minItems": 1,
      "maxItems": 40
    }
  },
  "required": [
    "id",
    "title",
    "theme_id",
    "slides"
  ],
  "title": "Deck",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/aippt/v1/content.schema.json",
  "additionalProperties": false
}
