          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "objective": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "key_points": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Key Points",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Source Refs",
          "type": "array"
        },
        "layout_id": {
          "title": "Layout Id",
          "type": "string"
        },
        "page_role": {
