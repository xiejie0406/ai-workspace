      "type": "array",
      "minItems": 5,
      "maxItems": 20
    }
  },
  "required": [
    "pages"
  ],
  "title": "OutlineDraft",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.local/aippt/v1/outline.schema.json",
  "additionalProperties": false
