  "rules": {
    "requiredHeaders": [
      "来源编码",
      "SKU编码",
      "款号",
      "商品名称",
      "品类编码",
      "颜色编码",
      "颜色名称",
      "尺码",
      "尺码制式",
      "单位",
      "品牌",
      "材质",
      "季节",
      "京东商品ID",
      "京东链接"
    ],
    "optionalColumns": "All 44 extension columns may be absent; retain existing values on missing/blank cells unless explicitly cleared.",
    "unknownRequiredValues": "Keep acquisition draft; require user mapping before import. Never fabricate.",
    "textOnlyCodes": [
      "barcode",
      "categoryCode",
      "colorCode",
      "jdItemId",
      "platformProductId",
      "platformSkuId",
      "sizeCode",
      "skuCode",
      "sourceCode",
      "styleCode"
    ],
    "sizeSystems": [
      "CN",
      "EU",
      "US",
      "LETTER",
      "FREE"
    ],
    "urls": "HTTPS only; hostname required; userinfo forbidden; max 2048 characters per URL.",
    "timestamps": "ISO-8601 instant with time zone, export normalized UTC Z.",
    "detailImages": {
      "field": "sourceDetailImageUrls",
      "separator": "newline",
      "maxItems": 20
    },
    "observedPrice": {
      "pattern": "[0-9]{1,12}(\\.[0-9]{1,2})?",
      "affectsSalePrice": false
    },
    "observedCurrency": {
      "pattern": "[A-Z]{3}"
    },
    "listingYear": {
      "pattern": "[12][0-9]{3}"
    },
    "images": "Source references only; actual materials require separate reviewed import.",
    "inventory": "No inventory quantity in product import."
  }
