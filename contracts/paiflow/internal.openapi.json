  },
  "components": {
    "securitySchemes": {
      "WorkerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "短期独立服务token格式workerId.secret，中心只持SHA256与明确过期时间，并绑定engineProfile；用户token不能使用。无默认有效身份。"
      }
    },
    "parameters": {
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "LeaseVerification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "valid",
          "cancelRequested",
          "dslHash",
          "workflowVersionId",
          "lastEventSeq",
          "assignment"
        ],
        "properties": {
          "executionContext": {
            "$ref": "worker.schema.json#/properties/executionContext",
            "description": "中心实际RunContext投影在verify响应顶层；消费者核对后装配内部运行上下文，不向固定assignment或DSL写入。"
          },
          "valid": {
            "const": true
          },
          "cancelRequested": {
            "type": "boolean"
          },
          "dslHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "workflowVersionId": {
            "type": "string"
          },
          "lastEventSeq": {
            "type": "integer",
            "minimum": 0
          },
          "assignment": {
            "$ref": "worker.schema.json"
          }
        }
      },
      "VerifyEnvelope": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "const": 200
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/LeaseVerification"
          }
        }
      }
    }
  }
}
