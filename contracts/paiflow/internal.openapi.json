{
  "openapi": "3.1.0",
  "info": {
    "title": "PaiFlow中心执行协议",
    "version": "1.0.0",
    "description": "本地源码实施中的协议；租约/事件/结果/问答检查点与一次性执行许可已有中心持久化实现。模块默认关闭，真实MySQL、Worker联机、全部资源/副作用端点和原页面尚未验证。受限Worker过滤器在MVC解析前认证并限制实际字节。 模型逐次操作共享契约已保存；正式能力仍依赖真实固定资源、动态消息授权、审批和Producer内部受控桥，缺任何项503/零operation写；没有新增私有Grant HTTP路由。"
  },
  "security": [
    {
      "WorkerBearer": []
    }
  ],
  "paths": {
    "/internal/paiflow/v1/runs/{runId}/history/python/read": {
      "post": {
        "summary": "冻结原Python普通大模型旧节点历史",
        "description": "当前Python有效租约和中心真实会话绑定；每Run/attempt只冻结一次。旧历史保留调试chatHistory，供应商消息仍为当前SYSTEM/USER。最近十轮中缺正式来源证据时明确阻塞，不静默遗漏。V2会话、Decision及嵌套历史另行迁移。追加复用原/history，但中心必须核对真实模型批准、完整原帧和成功结束，不接受裸问答作为来源。",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "python-history.schema.json#/$defs/ReadRequest"}}}},
        "responses": {
          "200": {"description": "固定历史快照；完整响应1800KiB以内，首次超限回滚，不截断", "content": {"application/json": {"schema": {"type": "object", "required": ["code", "data"], "properties": {"code": {"const": 200}, "msg": {"type": "string"}, "data": {"$ref": "python-history.schema.json#/$defs/ReadAck"}}}}}},
          "400": {"description": "请求形状或节点配置无效"},
          "403": {"description": "主体、引擎、固定节点或来源事实不符"},
          "409": {"description": "会话、快照或来源证据不一致"},
          "410": {"description": "运行已停止或租约失效"},
          "413": {"description": "完整响应超限或旧轮来源实际字节累计超过128MiB"},
          "503": {"description": "缺少可信历史来源或窗口内旧记录尚未完成证据迁移"}
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/history/java/open": {
      "post": {
        "summary": "冻结原Java模型旧历史并保存当前问题半轮",
        "description": "仅当前Java固定LLM节点、有效已begin租约和实际中心会话上下文。消息由中心可信输入重建；同attempt/node幂等回用固定快照，不能提交question、answer、chatId或轮数。回填仅中心内部读取正式模型账本和完整原帧，无Worker答案写入口。",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "java-history.schema.json#/$defs/OpenRequest"}}}},
        "responses": {
          "200": {"description": "同次固定快照；完整资源响应1800KiB以内，首次超限回滚本轮", "content": {"application/json": {"schema": {"type": "object", "required": ["code", "data"], "properties": {"code": {"const": 200}, "msg": {"type": "string"}, "data": {"$ref": "java-history.schema.json#/$defs/OpenAck"}}}}}},
          "400": {"description": "请求形状或原历史轮数无法执行"},
          "403": {"description": "固定引擎、节点、输入来源或服务身份不符"},
          "409": {"description": "会话绑定或持久快照不一致"},
          "410": {"description": "运行已停止或租约失效"},
          "413": {"description": "完整历史响应或输入来源超过预算"},
          "503": {"description": "真实历史上下文或中心来源端口未装配"}
        }
      }
    },
    "/internal/paiflow/v1/runs/claim": {
      "post": {
        "operationId": "claimRun",
        "description": "按服务身份引擎领取一个正式QUEUED任务；无任务data=null。中心原子保存租约后返回完整assignment。",
        "responses": {
          "200": {
            "description": "AjaxResult code=200,data为worker.schema或null"
          },
          "401": {
            "description": "短期服务身份无效/过期"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/lease/verify": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "verifyLease",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "worker.schema.json#/$defs/LeaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AjaxResult code=200,data为LeaseVerification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "服务身份失效"
          },
          "403": {
            "description": "发起者账户/空间/平台运行权限撤销"
          },
          "409": {
            "description": "租约/Worker/引擎不匹配"
          },
          "410": {
            "description": "失租约/已终态/超过截止时间"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/execution/begin": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "beginExecutionOnce",
        "description": "Worker完成verify快照与本地预检后、进入原引擎前仅调用一次。中心在运行行锁/CAS内持久化签发时间；许可不重发。任何409、超时、ACK未知或绑定不一致均不得执行，也不得由该失败路径提交终态，以免关闭首个持许可方的运行。签发登记不证明节点执行或外部副作用完成。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "worker.schema.json#/$defs/LeaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "仅首次许可成功，code=200/data严格核对当前运行、租约、次数、固定版本和DSL哈希",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "worker.schema.json#/$defs/ExecutionBeginAck"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "未知字段或租约次数类型无效"
          },
          "401": {
            "description": "短期服务身份无效"
          },
          "403": {
            "description": "运行发起者平台或空间权限撤销"
          },
          "409": {
            "description": "许可已签发或Worker/租约绑定冲突；禁止重试执行"
          },
          "410": {
            "description": "租约失效、已终态、超过期限或已请求取消"
          },
          "413": {
            "description": "原始控制正文超过16KiB"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/heartbeat": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "heartbeat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "worker.schema.json#/$defs/LeaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "code=200,data={valid:true,cancelRequested:boolean,leaseExpiresAt:UTC时间}；新租约最长60秒且不越过deadline"
          },
          "409": {
            "description": "租约不匹配"
          },
          "410": {
            "description": "租约过期"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/events": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "appendEvent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "events.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "code=200,data={accepted:true,seq:实际提交序号}；同序号同内容幂等"
          },
          "400": {
            "description": "未知字段/节点/类型/终态事件或凭据拒绝"
          },
          "409": {
            "description": "跳号、同号不同内容或尚未取得一次性执行许可"
          },
          "413": {
            "description": "原始/编码事件正文超过4MiB；不裁剪原节点生命周期输入/输出"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/result": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "completeRun",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "worker.schema.json#/$defs/Result"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "code=200,data={accepted:true,state:提交状态}；中心原子保存终态与事件；完全相同结果重复确认"
          },
          "409": {
            "description": "已有不同终态或结果，COMPLETED尚未取得一次性执行许可，或用户取消先保存后提交新的COMPLETED；已记录节点/用量事实保留"
          },
          "410": {
            "description": "失租约/超过deadline"
          },
          "413": {
            "description": "结果正文超过2MiB"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/checkpoints": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "createCheckpoint",
        "description": "当前仅顶层原question-answer；固定nodeParam核对等待/重问策略。Worker只读等待/一次性消费，真实回复来自受保护中心用户入口。RunService尚未派发QA资源图。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "checkpoints.schema.json#/$defs/CreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AjaxResult code=200,data为检查点回执；已停止消费返回consumed=false并确认stopped=true",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "checkpoints.schema.json#/$defs/CreateAck"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "固定节点/原题面/等待策略或字段类型无效"
          },
          "401": {
            "description": "服务身份无效"
          },
          "403": {
            "description": "运行发起者或当前权限撤销"
          },
          "404": {
            "description": "检查点不在当前run/lease/attempt域"
          },
          "409": {
            "description": "版本、重复请求或消费状态冲突"
          },
          "503": {
            "description": "嵌套迭代问答归属尚未接通"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/checkpoints/{checkpointId}/resume/poll": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "name": "checkpointId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "pollCheckpoint",
        "description": "当前仅顶层原question-answer；固定nodeParam核对等待/重问策略。Worker只读等待/一次性消费，真实回复来自受保护中心用户入口。RunService尚未派发QA资源图。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "checkpoints.schema.json#/$defs/PollRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AjaxResult code=200,data为检查点回执；已停止消费返回consumed=false并确认stopped=true",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "checkpoints.schema.json#/$defs/PollAck"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "固定节点/原题面/等待策略或字段类型无效"
          },
          "401": {
            "description": "服务身份无效"
          },
          "403": {
            "description": "运行发起者或当前权限撤销"
          },
          "404": {
            "description": "检查点不在当前run/lease/attempt域"
          },
          "409": {
            "description": "版本、重复请求或消费状态冲突"
          },
          "503": {
            "description": "嵌套迭代问答归属尚未接通"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/checkpoints/{checkpointId}/consume": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "name": "checkpointId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "consumeCheckpoint",
        "description": "当前仅顶层原question-answer；固定nodeParam核对等待/重问策略。Worker只读等待/一次性消费，真实回复来自受保护中心用户入口。RunService尚未派发QA资源图。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "checkpoints.schema.json#/$defs/ConsumeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AjaxResult code=200,data为检查点回执；已停止消费返回consumed=false并确认stopped=true",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "checkpoints.schema.json#/$defs/ConsumeAck"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "固定节点/原题面/等待策略或字段类型无效"
          },
          "401": {
            "description": "服务身份无效"
          },
          "403": {
            "description": "运行发起者或当前权限撤销"
          },
          "404": {
            "description": "检查点不在当前run/lease/attempt域"
          },
          "409": {
            "description": "版本、重复请求或消费状态冲突"
          },
          "503": {
            "description": "嵌套迭代问答归属尚未接通"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/resources/{resourceId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "name": "resourceId",
          "in": "path",
          "required": true,
          "schema": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "not": {
                  "anyOf": [
                    {
                      "pattern": "^tool:"
                    },
                    {
                      "pattern": "^data:"
                    }
                  ]
                }
              },
              {
                "$ref": "tool-operations.schema.json#/$defs/ToolResourceId"
              },
              {
                "$ref": "data-operations.schema.json#/$defs/DataResourceId"
              }
            ]
          }
        }
      ],
      "post": {
        "operationId": "readRuntimeResource",
        "description": "按resourceId的model/tool/data类别核对固定资源、当前身份和租约后返回公开描述；不交私有Grant或连接材料。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "model-operations.schema.json#/$defs/LeaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "若依code=200/data；模型或工具准确固定资源公开投影。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "model-operations.schema.json#/$defs/ChatSnapshot"
                        },
                        {
                          "$ref": "tool-operations.schema.json#/$defs/ToolResource"
                        },
                        {
                          "$ref": "data-operations.schema.json#/$defs/DataResource"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "未知字段、非法类型、伪造载荷或快照不一致"
          },
          "401": {
            "description": "Worker服务身份缺失或失效"
          },
          "403": {
            "description": "当前平台、空间、资源或用途授权拒绝"
          },
          "409": {
            "description": "固定版本、幂等绑定或CAS冲突"
          },
          "410": {
            "description": "到期、取消或租约失效"
          },
          "413": {
            "description": "真实UTF8字节预算超限"
          },
          "503": {
            "description": "资源/用途/受控生产端未装配，不假成功"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/operations": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "startRuntimeOperation",
        "description": "按固定参数类别分派模型、Link工具及同步中心数据操作；各自核对当前身份、租约、begin、固定资源及费用/写入许可。数据成功同事务保存逻辑行和幂等回执，不新增数据轮询或取消路由。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "model-operations.schema.json#/$defs/ModelOperationRequest"
                  },
                  {
                    "$ref": "tool-operations.schema.json#/$defs/ToolOperationRequest"
                  },
                  {
                    "$ref": "data-operations.schema.json#/$defs/DataOperationRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AjaxResult成功，data为对应ModelStartAck、ToolOperationAck或同步DataOperationAck；不把资源消费者存在当真实业务已通过。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "model-operations.schema.json#/$defs/ModelStartAck"
                        },
                        {
                          "$ref": "tool-operations.schema.json#/$defs/ToolOperationAck"
                        },
                        {
                          "$ref": "data-operations.schema.json#/$defs/DataOperationAck"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "未知字段、非法类型、伪造载荷或快照不一致"
          },
          "401": {
            "description": "Worker服务身份缺失或失效"
          },
          "403": {
            "description": "当前平台、空间、资源或用途授权拒绝"
          },
          "409": {
            "description": "固定版本、幂等绑定或CAS冲突"
          },
          "410": {
            "description": "到期、取消或租约失效"
          },
          "413": {
            "description": "真实UTF8字节预算超限"
          },
          "503": {
            "description": "资源/用途/受控生产端未装配，不假成功"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/operations/{operationId}/frames": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "post": {
        "operationId": "modelFrames",
        "description": "只读正式原帧；分页交付投影及operationState分开，真实finish/lastSeq保全尾usage，支持空最终ACK。读取不新发Provider。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "model-operations.schema.json#/$defs/FramesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AjaxResult code=200/data，完整绑定及停止/尾帧仍须严格核对",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "model-operations.schema.json#/$defs/ModelFramesAck"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "未知字段/非法类型/游标/参数"
          },
          "401": {
            "description": "独立服务身份失效"
          },
          "403": {
            "description": "平台/空间/资源/费用授权拒绝"
          },
          "409": {
            "description": "租约/固定版本/幂等/CAS冲突"
          },
          "410": {
            "description": "已到期/取消/失租约"
          },
          "413": {
            "description": "真实UTF8正文预算超限"
          },
          "503": {
            "description": "缺真实资源/动态消息/审批/Producer受控transport桥，零operation写"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/operations/{operationId}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "post": {
        "operationId": "cancelRuntimeOperation",
        "description": "按operationId分派模型或工具取消；本地关闭HTTP不能证明上游停止。工具只有中心真实proofId才可stopped=true，已发送且无法确认时保留EFFECT_UNKNOWN，不自动重发。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "model-operations.schema.json#/$defs/LeaseRequest"
                  },
                  {
                    "$ref": "tool-operations.schema.json#/$defs/ToolCancelRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "若依code=200/data；必须核对完整绑定与真实停止证明。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "model-operations.schema.json#/$defs/ModelCancelAck"
                        },
                        {
                          "$ref": "tool-operations.schema.json#/$defs/ToolCancelAck"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "未知字段、非法类型、伪造载荷或快照不一致"
          },
          "401": {
            "description": "Worker服务身份缺失或失效"
          },
          "403": {
            "description": "当前平台、空间、资源或用途授权拒绝"
          },
          "409": {
            "description": "固定版本、幂等绑定或CAS冲突"
          },
          "410": {
            "description": "到期、取消或租约失效"
          },
          "413": {
            "description": "真实UTF8字节预算超限"
          },
          "503": {
            "description": "资源/用途/受控生产端未装配，不假成功"
          }
        }
      }
    },
    "/internal/paiflow/v1/runs/{runId}/operations/{operationId}/status": {
