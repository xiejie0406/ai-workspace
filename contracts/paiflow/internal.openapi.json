              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "msg": {
                      "type": "string"
                    },
