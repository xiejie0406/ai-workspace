  "components": {
    "securitySchemes": {
      "platformBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "复用平台认证；Service逐次核对平台账号当前活动状态。"
      }
    },
    "schemas": {
      "PublicConfig": {
        "type": "object",
        "required": [
          "id",
          "category",
          "code",
          "name",
          "value",
          "isValid",
          "remarks",
          "createTime",
          "updateTime"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "remarks": {
            "type": [
              "string",
              "null"
            ]
          },
          "isValid": {
            "type": "integer",
            "const": 1
          },
          "createTime": {
            "type": [
              "string",
              "null"
            ],
            "description": "原yyyy-MM-dd HH:mm:ss，无偏移；旧GMT+8展示语义"
          },
          "updateTime": {
            "type": [
              "string",
              "null"
            ],
            "description": "原yyyy-MM-dd HH:mm:ss，无偏移；旧GMT+8展示语义"
          }
        },
        "additionalProperties": false
      },
      "PlatformError": {
        "type": "object",
        "required": [
          "code",
          "msg"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              400,
              401,
              403,
              413,
              500,
              503
            ]
          },
          "msg": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
