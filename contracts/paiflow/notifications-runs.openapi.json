{
  "openapi": "3.0.3",
  "info": {
    "title": "PaiFlow站内通知与运行查询",
    "version": "1.0.0",
    "description": "本地源码接口；通知020两表未执行，需paiflow.enabled与实际平台权限。不是运行/页面通过证据。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "platformBearer": []
    }
  ],
  "paths": {
    "/paiflow/legacy/notifications/list": {
      "get": {
        "summary": "读取本人可见通知与当前页分组",
        "x-platform-permission": "paiflow:notification:query",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "0",
                "PERSONAL",
                "BROADCAST",
                "SYSTEM",
                "PROMOTION"
              ]
            }
          },
          {
            "name": "unreadOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实际数据成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        0
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/NotificationPage"
                    },
                    "message": {
                      "type": "string"
                    },
                    "desc": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "平台身份失效"
          },
          "403": {
            "description": "权限/主体/资源拒绝"
          },
          "404": {
            "description": "资源不存在或不可访问"
          },
          "409": {
            "description": "记录/事件不一致"
          },
          "413": {
            "description": "超预算"
          },
          "503": {
            "description": "适配未配置"
          }
        }
      }
    },
