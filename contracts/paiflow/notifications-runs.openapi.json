          },
          "503": {
            "description": "适配未配置"
          }
        }
      }
    },
    "/paiflow/runs/statistics": {
      "get": {
        "summary": "空间真实运行状态统计",
        "x-platform-permission": "paiflow:run:query",
        "parameters": [
          {
            "name": "spaceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "workflowId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实际数据成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
