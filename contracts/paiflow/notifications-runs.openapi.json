    "/paiflow/runs/{id}/traces/export": {
      "get": {
        "summary": "固定中心事件水位NDJSON导出；最多一万事件、16MiB，缺行拒绝",
        "x-platform-permission": "paiflow:run:query",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实际完整事件行；Content-Disposition固定文件名，Cache-Control:no-store，nosniff；不是AjaxResult信封",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "平台身份失效"
          },
          "403": {
            "description": "权限/主体/资源拒绝"
          },
          "404": {
            "description": "资源不存在或不可访问"
          },
          "409": {
            "description": "记录/事件不一致"
          },
          "413": {
            "description": "超预算"
          },
          "503": {
            "description": "适配未配置"
          }
        }
      }
    }
