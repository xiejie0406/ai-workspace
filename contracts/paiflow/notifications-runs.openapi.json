  "components": {
    "securitySchemes": {
      "platformBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Notification": {
        "type": "object",
        "required": [
          "title",
          "body",
          "templateCode",
          "payload",
          "creatorUid",
          "createdAt",
          "expireAt",
          "meta",
          "readAt",
          "receivedAt",
          "id",
          "type",
          "isRead"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "templateCode": {
            "type": "string",
            "nullable": true
          },
          "payload": {
            "type": "string",
            "nullable": true
          },
          "creatorUid": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "expireAt": {
            "type": "string",
            "nullable": true
          },
          "meta": {
            "type": "string",
            "nullable": true
          },
          "readAt": {
            "type": "string",
            "nullable": true
          },
          "receivedAt": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "BROADCAST",
              "SYSTEM",
              "PROMOTION"
            ]
          },
          "isRead": {
            "type": "boolean"
          }
        }
      },
      "NotificationPage": {
        "type": "object",
        "required": [
          "notifications",
          "notificationsByType",
          "pageIndex",
          "pageSize",
          "totalCount",
          "totalPages",
          "unreadCount"
        ],
        "properties": {
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "notificationsByType": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Notification"
              }
            }
          },
          "pageIndex": {
            "type": "integer",
            "format": "int64"
          },
          "pageSize": {
            "type": "integer",
            "format": "int64"
          },
          "totalCount": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int64"
          },
          "unreadCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MarkRead": {
        "type": "object",
        "required": [
          "notificationIds",
          "markAll"
        ],
        "properties": {
          "notificationIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "integer",
              "minimum": 1,
              "format": "int64"
            }
          },
          "markAll": {
            "type": "boolean"
          }
        },
        "description": "markAll=true仅处理本用户可见通知，超过一万未读拒绝；false只处理传入可见IDs。"
      },
      "RunSummary": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "workflowId": {
            "type": "string"
          },
          "workflowVersionId": {
            "type": "string"
          },
          "spaceId": {
            "type": "string"
          },
          "ownerUid": {
            "type": "string"
          },
          "engineProfile": {
            "type": "string"
          },
          "createTime": {
            "type": "string"
          },
          "updateTime": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "COMPLETED",
              "FAILED",
              "CANCELLED",
              "EFFECT_UNKNOWN"
            ]
          },
          "attempt": {
            "type": "integer",
            "format": "int64"
          },
          "lastEventSeq": {
            "type": "integer",
            "format": "int64"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "runId",
          "workflowId",
          "workflowVersionId",
          "spaceId",
          "ownerUid",
          "engineProfile",
          "createTime",
          "updateTime",
          "state",
          "attempt",
          "lastEventSeq",
          "revision"
        ]
      },
      "RunPage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "current": {
            "type": "integer",
            "format": "int64"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "pages": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RunStatistics": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "counts": {
            "type": "object",
            "properties": {
              "QUEUED": {
                "type": "integer",
                "minimum": 0,
                "format": "int64"
              },
              "RUNNING": {
                "type": "integer",
                "minimum": 0,
                "format": "int64"
              },
              "CANCEL_REQUESTED": {
                "type": "integer",
                "minimum": 0,
                "format": "int64"
              },
              "COMPLETED": {
                "type": "integer",
                "minimum": 0,
                "format": "int64"
              },
              "FAILED": {
                "type": "integer",
                "minimum": 0,
                "format": "int64"
              },
              "CANCELLED": {
                "type": "integer",
                "minimum": 0,
                "format": "int64"
              },
              "EFFECT_UNKNOWN": {
                "type": "integer",
                "minimum": 0,
                "format": "int64"
              }
            }
          }
        },
        "description": "只统计实际Run状态，不含估算Token/成本。"
      }
    }
  },
  "x-source-review-date": "2026-10-03T15:36:25.538579+00:00",
