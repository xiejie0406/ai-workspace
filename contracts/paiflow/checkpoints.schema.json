{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paiflow:checkpoints:v1",
  "title": "PaiFlow中心问答检查点协议",
  "x-status": "center-source-implemented-local-checks-in-progress-no-live-integration",
  "x-prefix": "/internal/paiflow/v1/runs/{runId}",
  "description": "中心保存原问答题面、真实用户回复与一次性消费。仅顶层节点已实现；RunService尚未派发QA资源图，未联机、未完成页面/跨进程恢复。",
  "x-source": {
    "question-shape": "core/workflow/engine/nodes/question_answer/question_answer_node.py:182-196,259-310,364-384",
    "resume-shape": "core/workflow/engine/nodes/question_answer/question_answer_node.py:312-362",
    "event-allowlist": "core/workflow/engine/nodes/question_answer/question_answer_node.py:29-38,750-842",
    "timeout": "core/workflow/engine/nodes/question_answer/question_answer_node.py:185,907; timeout输入1..5分钟，原执行乘60，每次fetch等待相同秒数",
    "retries-timestamp": "core/workflow/cache/event_registry.py:224-281; 首回复retries=0，后续+1；timestamp为中心写入时Unix秒",
    "resume-api": "core/workflow/api/v1/chat/debug.py:161-167; open.py:205-211; event_type/content完整JSON，使用event.timeout续TTL",
    "slot-retry": "core/workflow/engine/nodes/question_answer/question_answer_node.py:606-748; 首轮current_retries=1；不完整则重问；递归使用resume.retries+1，maxRetryCounts=1..5",
    "option-routing": "core/workflow/engine/nodes/question_answer/question_answer_node.py:386-448; 按原列表顺序首个匹配或默认，输出id实际为选项name，branch为原option.id，默认在前会优先匹配，迁移不重排",
    "nonce": "原节点无独立nonce约束；当前Worker服务身份+run/lease/attempt/checkpoint/revision+中心CAS去重已绑定消费者"
  },
  "x-endpoints": {
    "POST /checkpoints": {
      "request": "#/$defs/CreateRequest",
      "responseData": "#/$defs/CreateAck"
    },
    "POST /checkpoints/{checkpointId}/resume/poll": {
      "request": "#/$defs/PollRequest",
      "responseData": "#/$defs/PollAck"
    },
    "POST /checkpoints/{checkpointId}/consume": {
      "request": "#/$defs/ConsumeRequest",
      "responseData": "#/$defs/ConsumeAck"
    }
  },
  "x-rules": [
    "create/poll/consume检查当前Worker服务身份、有效run/leaseId/attempt、nodeId属于固定question-answer DSL及iteration/ordinal；不能跨run/旧attempt读消费",
    "create同idempotencyKey同完整请求回同检查点，异请求拒409；同节点/iteration每次重问ordinal+1，最多固定DSL声明maxRetryCounts，普通direct/option只有一次",
    "题面保留type/content及option的id/text/content_type；options.id是原A-Z/default显示名，不等于路由UUID；needReply和timeout由固定DSL核对，不由Worker自改",
    "中心deadline为min(run.deadline,创建时刻+timeoutSeconds)；timeoutSeconds来自原1..5分钟乘60；等待继续心跳，过期/取消/失租约停止；不无限扩大等待",
    "标准用户回复入口只接受当前有效run发起者、平台权限和空间关系；回复只能写一次且CAS到RESUMED，event_type仅resume/ignore/abort，content完整string；中心生成retries=ordinal-1/timestamp，不信任用户metadata",
    "poll body afterRevision只游标读取当前checkpoint，不提供回复内容或token；可以稳定重发当前状态；每次poll响应有界且不超过HTTP请求超时，不改变状态/费用",
    "consume只允许RESUMED且expectedRevision匹配，中心行锁/CAS一次转CONSUMED并返回原resumeData={message:原JSON字符串(event_type/content),metadata:{retries,timestamp}}；同幂等键同完全相同请求重发同回执；异请求/未回复/旧revision/过期/取消明确拒绝",
    "没有resumeToken或额外签名密钥；幂等回执由中心保存，Worker最多保留当前瞬时请求用于相同consume重发",
    "原ignore在needReply=true时失败；abort原节点失败；非法reply不造默认；原选项DEFAULT与合法模型槽位算法保留",
    "中心正式run终态/取消负责关闭未消费检查点；Worker不自行保存WAITING成功或伪造回复；原节点跨进程重建/已消费后引擎重启仍未实现",
    "create成功后Worker提交checkpoint事件含checkpointId/revision/deadline和完整原interrupt，正式事件仍走现有seq/ACK；事件不能代替检查点状态",
    "RunService尚不派发QA资源图；算法/中心技术测试通过不代表原QA页面、会话、恢复或完整21节点已经联机",
    "ACK包含deadline/stopped；消费与到期/取消并发时返回consumed=false/state=EXPIRED|CANCELLED/stopped=true，不含resumeData。顶层问答当前可适配；中心尚未绑定迭代内节点，明确拒绝不改为顶层归属。",
    "revision沿中心现表从0开始：create=0、reply=1、consume=2；afterRevision/expectedRevision允许0，CAS仍严格核对当前状态和revision；ACK所有已定义deadline/stopped保留。",
    "重复create返回同一检查点的当前状态；终止/已消费不会重新打开等待。正式接口/权限/Mapper仍须实际部署验证；原未挂载resume接口不是完成事实。"
  ],
  "$defs": {
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "enum": [
            "option",
            "direct"
          ]
        },
        "content": {
          "type": "string"
        },
        "option": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "content_type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^([A-Z]|default)$"
              },
              "text": {
                "type": "string"
              },
              "content_type": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "direct"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "option"
              ]
            }
          }
        }
      ]
    },
    "CreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "attempt",
        "nodeId",
        "ordinal",
        "question",
        "needReply",
        "timeoutSeconds",
        "idempotencyKey"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "nodeId": {
          "type": "string",
          "pattern": "^question-answer::",
          "maxLength": 255
        },
        "iterationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "$comment": "当前中心对该字段明确返回503，尚不支持嵌套迭代域。"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "question": {
          "$ref": "#/$defs/Question"
        },
        "needReply": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 300,
          "multipleOf": 60
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "maxLength": 128
        }
      }
    },
    "CreateAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "revision",
        "state",
        "deadline",
        "stopped"
      ],
      "properties": {
        "checkpointId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "WAITING",
            "RESUMED",
            "CONSUMED",
            "EXPIRED",
            "CANCELLED"
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "stopped": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "CONSUMED",
                  "EXPIRED",
                  "CANCELLED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "stopped": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "stopped": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "PollRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "attempt",
        "afterRevision"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "afterRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PollAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "revision",
        "state",
        "deadline",
        "stopped"
      ],
      "properties": {
        "checkpointId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "WAITING",
            "RESUMED",
            "EXPIRED",
            "CANCELLED",
            "CONSUMED"
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "stopped": {
          "type": "boolean"
        }
      }
    },
    "ConsumeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "attempt",
        "expectedRevision",
        "idempotencyKey"
      ],
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "maxLength": 128
        }
      }
    },
    "ResumeData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "metadata"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "原JSON字符串，仅包含event_type=resume/ignore/abort与content:string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retries",
            "timestamp"
          ],
          "properties": {
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "timestamp": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "ConsumeAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "consumed",
        "revision",
        "deadline",
        "stopped",
        "state"
      ],
      "properties": {
        "checkpointId": {
          "type": "string",
          "minLength": 1
        },
        "consumed": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "resumeData": {
          "$ref": "#/$defs/ResumeData"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "stopped": {
          "const": true
        },
        "state": {
          "enum": [
            "CONSUMED",
            "EXPIRED",
            "CANCELLED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "consumed": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "resumeData"
            ],
            "properties": {
              "state": {
                "const": "CONSUMED"
              },
              "revision": {
                "type": "integer",
                "minimum": 2
              }
            }
          },
          "else": {
            "properties": {
              "state": {
                "enum": [
                  "EXPIRED",
                  "CANCELLED"
                ]
              }
            },
            "not": {
              "required": [
                "resumeData"
              ]
            }
          }
        }
      ]
    }
  }
}
