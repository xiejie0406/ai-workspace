              "minLength": 1,
              "maxLength": 256
            }
          ]
        },
        "workflowVersionId": {
          "$ref": "urn:paiflow:worker:v1#/properties/workflowVersionId"
        },
        "dslHash": {
          "$ref": "urn:paiflow:worker:v1#/properties/dslHash"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "enum": [
            "xinghuo",
            "openai"
          ]
        }
      },
      "x-private-internal-bridge-only": true,
      "description": "完整内部绑定，不能授予费用或执行许可；私有SDK Grant桥未装配，无私有Grant HTTP路由。"
    },
