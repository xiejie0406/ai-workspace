    "FramesAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "leaseId",
        "attempt",
        "nodeId",
        "iterationId",
        "workflowVersionId",
        "dslHash",
        "operationId",
        "resourceId",
        "resourceVersion",
        "provider",
        "state",
        "operationState",
        "frames",
        "nextCursor",
        "done",
        "lastSeq",
        "finishSeq",
        "failureKind"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/PrivateBinding/properties/runId"
        },
        "leaseId": {
          "$ref": "#/$defs/PrivateBinding/properties/leaseId"
        },
        "attempt": {
          "$ref": "#/$defs/PrivateBinding/properties/attempt"
        },
        "nodeId": {
          "$ref": "#/$defs/PrivateBinding/properties/nodeId"
        },
        "iterationId": {
          "$ref": "#/$defs/PrivateBinding/properties/iterationId"
        },
        "workflowVersionId": {
          "$ref": "#/$defs/PrivateBinding/properties/workflowVersionId"
        },
        "dslHash": {
          "$ref": "#/$defs/PrivateBinding/properties/dslHash"
        },
        "operationId": {
          "$ref": "#/$defs/PrivateBinding/properties/operationId"
        },
        "resourceId": {
          "$ref": "#/$defs/PrivateBinding/properties/resourceId"
        },
        "resourceVersion": {
          "$ref": "#/$defs/PrivateBinding/properties/resourceVersion"
        },
        "provider": {
          "$ref": "#/$defs/PrivateBinding/properties/provider"
        },
        "state": {
          "enum": [
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "EFFECT_UNKNOWN"
          ]
        },
        "operationState": {
          "enum": [
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "EFFECT_UNKNOWN"
          ]
        },
        "frames": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "x-max-json-utf8-bytes": 65536
          }
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "done": {
          "type": "boolean"
        },
        "lastSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "finishSeq": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          ]
        },
        "failureKind": {
          "enum": [
            null,
            "provider",
            "authorization",
            "protocol",
            "transport",
            "deadline",
            "lease",
            "cancelled",
            "budget"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operationState": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "failureKind": {
                "enum": [
                  "provider",
                  "authorization",
                  "protocol",
                  "transport",
                  "deadline",
                  "lease",
                  "cancelled",
                  "budget"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "operationState": {
                "const": "COMPLETED"
              },
              "done": {
                "const": true
              },
              "finishSeq": {
                "type": "integer",
                "minimum": 1
              },
              "failureKind": {
