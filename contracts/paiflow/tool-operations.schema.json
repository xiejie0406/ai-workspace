          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[1-9][0-9]*$"
        },
        "resourceBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        "state": {
          "enum": [
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "EFFECT_UNKNOWN"
          ]
        },
        "failureKind": {
          "enum": [
            null,
            "provider",
            "authorization",
            "protocol",
            "transport",
            "deadline",
            "lease",
            "cancelled",
            "budget"
          ]
        },
        "legacyResponse": {
          "type": [
            "object",
            "null"
          ]
        },
        "stopped": {
          "type": "boolean"
        },
        "proofId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "RUNNING",
                  "COMPLETED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "failureKind": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "FAILED",
                  "CANCELLED",
                  "EFFECT_UNKNOWN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "failureKind": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "RUNNING"
              }
            }
          },
          "then": {
            "properties": {
              "legacyResponse": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "legacyResponse": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "FAILED"
              },
              "failureKind": {
                "const": "provider"
              }
            }
          },
          "then": {
            "properties": {
              "legacyResponse": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "FAILED",
                  "CANCELLED",
                  "EFFECT_UNKNOWN"
                ]
              },
              "failureKind": {
                "not": {
                  "const": "provider"
                }
              }
            }
          },
          "then": {
            "properties": {
              "legacyResponse": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stopped": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "COMPLETED",
                  "FAILED",
                  "CANCELLED"
                ]
              },
              "proofId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stopped": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "proofId": {
                "type": "null"
              }
            }
          }
        }
      ],
      "x-maxUtf8Bytes": 2097152
    },
