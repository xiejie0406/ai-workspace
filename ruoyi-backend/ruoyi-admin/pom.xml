<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ruoyi</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>ruoyi-admin</artifactId>

    <description>
        web服务入口
    </description>

    <dependencies>

        <!-- PaiFlow 正式业务中心；原 React 前端及计算 Worker 保持独立 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-paiflow</artifactId>
            <version>${ruoyi.version}</version>
        </dependency>

        <!-- 生产健康与 JVM/HTTP 指标；默认只暴露 Spring Boot 的 health 端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- spring-boot-devtools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional> <!-- 表示依赖不会传递 -->
        </dependency>

        <!-- spring-doc -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

         <!-- Mysql驱动包 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 核心模块-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-framework</artifactId>
        </dependency>

        <!-- AI Interview Coach 业务模块；认证与安全仍由 RuoYi 提供 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-interview</artifactId>
        </dependency>

        <!-- 服装智能选品与报价业务模块；认证与安全继续由 RuoYi 提供 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-fashion</artifactId>
        </dependency>

        <!-- AI 图片编辑；React / Python 保留独立算法，正式状态由本模块保存 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-aipicture</artifactId>
        </dependency>

        <!-- Aden 桌面智能执行平台；身份与安全继续由 RuoYi 提供 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-aden</artifactId>
        </dependency>

        <!-- AI 演示文稿；正式业务中心，功能默认关闭 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-aippt</artifactId>
            <exclusions>
                <!-- COS通过标准JCE加载Provider；统一使用PaiSmart的jdk18on，避免3071个同名类双装配。 -->
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- PaiCLI 中心 API；本机工具、CLI/TUI、Runner、评测保持独立进程 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>paicli-api</artifactId>
        </dependency>

        <!-- PaiSmart 知识库；使用共享认证及数据源，业务缺省关闭 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-paismart</artifactId>
        </dependency>

        <!-- APS HTTP 适配层与 MySQL 持久化适配层；功能默认关闭 -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>aps-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>aps-infrastructure-mysql</artifactId>
        </dependency>

        <!-- 定时任务-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-quartz</artifactId>
        </dependency>

        <!-- 代码生成-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-generator</artifactId>
        </dependency>

        <!-- 共享装配的COS/BC离线兼容检查，不进入运行依赖。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <addResources>true</addResources>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>   
                <groupId>org.apache.maven.plugins</groupId>   
                <artifactId>maven-war-plugin</artifactId>   
                <version>3.1.0</version>   
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warName>${project.artifactId}</warName>
                </configuration>   
           </plugin>   
        </plugins>
        <finalName>${project.artifactId}</finalName>
    </build>

</project>
