  {
    "name": "search_code",
    "description": "RAG 语义辅助检索代码库，根据自然语言描述查找相关代码块；精确符号/字符串定位请优先用 grep_code/glob_files/read_file；默认 top_k=5，可显式指定（上限 30）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "自然语言查询描述，例如'用户登录的实现'"
        },
        "top_k": {
          "type": "integer",
          "description": "返回结果数量（默认 5，上限 30）"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "source": "BUILTIN",
    "readOnly": true,
    "capability": "rag",
    "approvalRequired": false,
    "schemaVersion": 1
  },
