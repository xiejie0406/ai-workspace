  {
    "name": "save_memory",
    "description": "当且仅当用户明确说“记一下”“记住”“以后记得”或要求保存长期偏好/稳定事实时调用，把精炼事实写入长期记忆；scope 默认 project，跨项目偏好才用 global；不要保存一次性任务请求、临时文件名或模型猜测。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "fact": {
          "type": "string",
          "description": "要长期保存的稳定事实或用户偏好，必须精炼、可跨会话复用"
        },
        "scope": {
          "type": "string",
          "description": "记忆作用域：project 或 global。默认 project；跨项目长期偏好才用 global"
        },
        "replace_id": {
          "type": "string",
          "description": "仅当用户明确选择用新内容替换某条冲突记忆时，传该旧记忆 id"
        },
        "keep_both": {
          "type": "boolean",
          "description": "仅当用户明确要求冲突的新旧两条都保留时传 true"
        }
      },
      "required": [
        "fact"
      ],
      "additionalProperties": false
    },
    "source": "BUILTIN",
    "readOnly": false,
    "capability": "memory",
    "approvalRequired": true,
    "schemaVersion": 1
  },
