  {
    "name": "glob_files",
    "description": "按文件名 glob 查找项目内文件（只读、实时、尊重常见忽略目录）；适合先定位候选文件，例如 **/*Service.java",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "glob 模式，例如 **/*.java、**/*Controller*、README.md"
        },
        "path": {
          "type": "string",
          "description": "搜索起始目录，默认 ."
        },
        "max_results": {
          "type": "integer",
          "description": "最多返回结果数，默认 50，上限 200"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "source": "BUILTIN",
    "readOnly": true,
    "capability": "files",
    "approvalRequired": false,
    "schemaVersion": 1
  },
  {
    "name": "grep_code",
    "description": "在项目内按关键字或正则实时搜索代码（只读、优先 ripgrep、返回文件和行号）；适合精确符号/字符串定位，找到后再 read_file 读取上下文",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "要搜索的关键字或正则"
        },
        "path": {
          "type": "string",
          "description": "搜索起始目录，默认 ."
        },
        "glob": {
          "type": "string",
          "description": "可选文件 glob 过滤，例如 **/*.java"
        },
        "regex": {
          "type": "boolean",
          "description": "是否按 Java 正则解释 pattern，默认 false 表示字面量搜索"
        },
        "case_sensitive": {
          "type": "boolean",
          "description": "是否大小写敏感，默认 true"
        },
        "context_lines": {
          "type": "integer",
          "description": "每条命中前后上下文行数，默认 0，上限 5"
        },
        "max_results": {
          "type": "integer",
          "description": "最多返回命中数，默认 50，上限 200"
        },
        "head_limit": {
          "type": "integer",
          "description": "单个文件最多返回多少条命中，默认 20，上限 50"
        },
        "max_chars": {
          "type": "integer",
          "description": "单次工具结果字符预算，默认 24000，上限 60000"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "source": "BUILTIN",
    "readOnly": true,
    "capability": "files",
    "approvalRequired": false,
    "schemaVersion": 1
  },
  {
    "name": "execute_command",
    "description": "在当前项目目录中执行短时 Shell 命令（默认 60 秒超时，不允许全盘扫描）",
    "inputSchema": {
