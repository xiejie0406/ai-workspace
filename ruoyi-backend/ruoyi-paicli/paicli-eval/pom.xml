<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ruoyi</groupId><artifactId>paicli-eval</artifactId><version>3.9.2</version>
  <name>PaiCLI paicli-eval</name>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><skipTests>false</skipTests></properties>
  <dependencies><dependency><groupId>com.ruoyi</groupId><artifactId>paicli-core</artifactId><version>3.9.2</version></dependency><dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>

        
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

        
        </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.3.0</version><configuration><forceCreation>true</forceCreation></configuration><executions><execution><id>agentbench-trusted-runner</id><phase>package</phase><goals><goal>jar</goal></goals><configuration><classifier>agentbench-runner</classifier><includes><include>com/paicli/eval/benchmark/BenchmarkRelayWorkerMain*.class</include><include>com/paicli/eval/benchmark/BenchmarkToolRegistry*.class</include><include>com/paicli/eval/benchmark/BenchmarkToolProfile*.class</include><include>com/paicli/eval/benchmark/relay/**</include></includes><archive><addMavenDescriptor>false</addMavenDescriptor><manifest><mainClass>com.paicli.eval.benchmark.BenchmarkRelayWorkerMain</mainClass></manifest></archive></configuration></execution></executions></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.5.1</version><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration><createDependencyReducedPom>false</createDependencyReducedPom><filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude></excludes></filter></filters><transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>com.paicli.eval.benchmark.BenchmarkCoordinatorMain</mainClass></transformer></transformers></configuration></execution></executions></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version><configuration><release>17</release></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version><configuration><argLine>-Dfile.encoding=UTF-8</argLine><skipTests>${skipTests}</skipTests><systemPropertyVariables><user.home>${project.build.directory}/test-home</user.home></systemPropertyVariables></configuration></plugin>
    
  </plugins></build>
    <profiles>
        <profile>
            <id>quick</id>
            <properties>
                <skipTests>false</skipTests>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <argLine>-Dfile.encoding=UTF-8</argLine>
                            <excludes>
                                <!-- 慢测试保留给全量 mvn test；日常 quick 回归跳过外部进程 / 网络超时 / 命令超时路径。 -->
                                <exclude>**/mcp/McpServerManagerTest.java</exclude>
                                <exclude>**/mcp/transport/StdioTransportTest.java</exclude>
                                <exclude>**/mcp/transport/StreamableHttpTransportTest.java</exclude>
                                <exclude>**/tool/ToolRegistryTest.java</exclude>
                                <exclude>**/web/WebFetcherTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>phase16-smoke</id>
            <properties>
                <skipTests>false</skipTests>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <argLine>-Dfile.encoding=UTF-8</argLine>
                            <includes>
                                <include>**/cli/MainInputNormalizationTest.java</include>
                                <include>**/hitl/RendererHitlHandlerTest.java</include>
                                <include>**/hitl/SwitchableHitlHandlerTest.java</include>
                                <include>**/render/*Test.java</include>
                                <include>**/render/inline/BottomStatusBarTest.java</include>
                                <include>**/render/inline/InlineRendererTest.java</include>
                                <include>**/render/inline/AnsiSeqTest.java</include>
                                <include>**/render/inline/BlockRegistryTest.java</include>
                                <include>**/render/inline/FoldableBlockTest.java</include>
                                <include>**/render/inline/SlashPaletteTest.java</include>
                                <include>**/tui/TuiBootstrapTest.java</include>
                                <include>**/tui/highlight/CodeHighlighterTest.java</include>
                                <include>**/tui/history/ConversationSnapshotTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
