<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.paiflow.mapper.PublicConfigMapper">
  <resultMap id="publicConfig" type="com.ruoyi.paiflow.domain.PublicConfigRecord">
    <id column="id" property="id"/>
    <result column="category" property="category"/><result column="code" property="code"/>
    <result column="name" property="name"/><result column="value" property="value"/>
    <result column="is_valid" property="isValid"/><result column="remarks" property="remarks"/>
    <result column="create_time" property="createTime"/><result column="update_time" property="updateTime"/>
  </resultMap>
  <sql id="columns">id,category,code,name,value,is_valid,remarks,create_time,update_time</sql>
  <!-- 原Controller前三个wrapper没有ORDER BY。1001只检测超预算，Service不截断成功。 -->
  <select id="byCategory" resultMap="publicConfig">SELECT <include refid="columns"/> FROM paiflow_public_config WHERE category=#{category} AND is_valid=1 LIMIT 1001</select>
  <select id="byCategoryAndCode" resultMap="publicConfig">SELECT <include refid="columns"/> FROM paiflow_public_config WHERE category=#{category} AND code=#{code} AND is_valid=1 LIMIT 1001</select>
  <select id="first" resultMap="publicConfig">SELECT <include refid="columns"/> FROM paiflow_public_config WHERE category=#{category} AND code=#{code} AND is_valid=1 LIMIT 1</select>
  <select id="tags" resultMap="publicConfig">SELECT <include refid="columns"/> FROM paiflow_public_config WHERE category='TAG' AND code=#{code} AND is_valid=1 ORDER BY update_time DESC LIMIT 1001</select>
</mapper>
