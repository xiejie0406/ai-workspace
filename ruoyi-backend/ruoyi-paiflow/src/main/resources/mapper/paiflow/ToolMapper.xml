<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.paiflow.mapper.ToolMapper">
 <resultMap id="tool" type="java.util.LinkedHashMap"><id column="id" property="id"/><result column="space_id" property="spaceId"/><result column="owner_user_id" property="ownerUserId"/><result column="plugin_id" property="pluginId"/><result column="name" property="name"/><result column="configuration_json" property="configurationJson"/><result column="draft_configuration_json" property="draftConfigurationJson"/><result column="revision" property="revision"/><result column="enabled" property="enabled"/><result column="temporary" property="temporary"/><result column="deleted" property="deleted"/><result column="create_time" property="createTime"/><result column="update_time" property="updateTime"/></resultMap>
 <resultMap id="version" type="java.util.LinkedHashMap"><id column="id" property="id"/><result column="tool_id" property="toolId"/><result column="space_id" property="spaceId"/><result column="owner_user_id" property="ownerUserId"/><result column="legacy_version" property="legacyVersion"/><result column="configuration_json" property="configurationJson"/><result column="configuration_hash" property="configurationHash"/><result column="create_time" property="createTime"/></resultMap>
 <resultMap id="operation" type="java.util.LinkedHashMap"><id column="id" property="id"/><result column="run_id" property="runId"/><result column="lease_id" property="leaseId"/><result column="attempt" property="attempt"/><result column="node_id" property="nodeId"/><result column="resource_id" property="resourceId"/><result column="idempotency_key" property="idempotencyKey"/><result column="request_key_hash" property="requestKeyHash"/><result column="request_hash" property="requestHash"/><result column="request_json" property="requestJson"/><result column="binding_json" property="bindingJson"/><result column="state" property="state"/><result column="dispatch_started" property="dispatchStarted"/><result column="response_json" property="responseJson"/><result column="failure_kind" property="failureKind"/><result column="revision" property="revision"/></resultMap>
 <select id="find" resultMap="tool">SELECT * FROM paiflow_tool WHERE id=#{id} AND deleted=0</select>
 <select id="lock" resultMap="tool">SELECT * FROM paiflow_tool WHERE id=#{id} AND deleted=0 FOR UPDATE</select>
 <select id="byPlugin" resultMap="tool">SELECT * FROM paiflow_tool WHERE plugin_id=#{plugin} AND deleted=0</select>
 <select id="list" resultMap="tool">SELECT * FROM paiflow_tool WHERE space_id=#{space} AND deleted=0 <if test="temporary != null">AND temporary=#{temporary}</if> AND name LIKE CONCAT('%',#{search},'%') ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}</select>
 <select id="count" resultType="long">SELECT COUNT(*) FROM paiflow_tool WHERE space_id=#{space} AND deleted=0 <if test="temporary != null">AND temporary=#{temporary}</if> AND name LIKE CONCAT('%',#{search},'%')</select>
 <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO paiflow_tool(space_id,owner_user_id,plugin_id,name,configuration_json,revision,enabled,temporary,deleted,create_by,update_by,create_time,update_time) VALUES(#{spaceId},#{ownerUserId},#{pluginId},#{name},#{configurationJson},0,1,#{temporary},0,#{actor},#{actor},UTC_TIMESTAMP(),UTC_TIMESTAMP())</insert>
 <update id="update">UPDATE paiflow_tool SET name=#{name},configuration_json=#{configurationJson},draft_configuration_json=#{draftConfigurationJson},temporary=#{temporary},enabled=#{enabled},deleted=#{deleted},revision=revision+1,update_by=#{actor},update_time=UTC_TIMESTAMP() WHERE id=#{id} AND revision=#{revision} AND deleted=0</update>
 <insert id="version" useGeneratedKeys="true" keyProperty="id">INSERT INTO paiflow_tool_version(tool_id,space_id,owner_user_id,legacy_version,configuration_json,configuration_hash,create_time) VALUES(#{toolId},#{spaceId},#{ownerUserId},#{legacyVersion},#{configurationJson},#{configurationHash},UTC_TIMESTAMP())</insert>
 <select id="fixed" resultMap="version">SELECT * FROM paiflow_tool_version WHERE id=#{id}</select>
 <select id="byVersion" resultMap="version">SELECT * FROM paiflow_tool_version WHERE tool_id=#{tool} AND legacy_version=#{version}</select>
 <select id="versions" resultMap="version">SELECT * FROM paiflow_tool_version WHERE tool_id=#{tool} ORDER BY id DESC</select>
 <select id="operation" resultMap="operation">SELECT * FROM paiflow_tool_operation WHERE id=#{id} FOR UPDATE</select>
 <select id="countOperations" resultType="long">SELECT COUNT(*) FROM paiflow_tool_operation WHERE run_id=#{run} AND node_id=#{node}</select>
 <select id="countResourceOperations" resultType="long">SELECT COUNT(*) FROM paiflow_tool_operation WHERE run_id=#{run} AND resource_id=#{resource}</select>
 <select id="nodeOperations" resultMap="operation">SELECT * FROM paiflow_tool_operation WHERE run_id=#{run} AND lease_id=#{lease} AND attempt=#{attempt} AND node_id=#{node}</select>
 <select id="request" resultMap="operation">SELECT * FROM paiflow_tool_operation WHERE run_id=#{run} AND lease_id=#{lease} AND attempt=#{attempt} AND request_key_hash=#{hash} FOR UPDATE</select>
 <insert id="insertOperation">INSERT INTO paiflow_tool_operation(id,run_id,lease_id,attempt,node_id,resource_id,idempotency_key,request_key_hash,request_hash,request_json,binding_json,state,dispatch_started,revision,create_time,update_time) VALUES(#{id},#{runId},#{leaseId},#{attempt},#{nodeId},#{resourceId},#{idempotencyKey},#{requestKeyHash},#{requestHash},#{requestJson},#{bindingJson},'RUNNING',1,0,UTC_TIMESTAMP(),UTC_TIMESTAMP())</insert>
 <update id="updateOperation">UPDATE paiflow_tool_operation SET state=#{state},response_json=#{responseJson},failure_kind=#{failureKind},revision=revision+1,update_time=UTC_TIMESTAMP() WHERE id=#{id} AND revision=#{revision}</update>
</mapper>
