  "findings": [
    {
      "topic": "timeouts/retry",
      "fact": "Default max_retries2 up to3 initial requests; connect5/read-write-pool600 per I/O; timeout/connection/408/409/429/5xx/x-should-retry retries with bounded Retry-After/exponential jitter; no initial retry wrapper for midstream errors. Original timeout covers perframe only."
    },
    {
      "topic": "private exit",
      "fact": "SDK follow_redirects=True; HTTPX trust_env=True. Explicit max_retries0, private fixed base_url/TLS/egress, redirectfalse/environmentfalse and fixed HTTP plus total deadlines required."
    },
    {
      "topic": "overrides/logs",
      "fact": "extra_body may override model/messages/stream; extra_headers/query/timeout may change request/authority. Only center-fixed effective kwargs; no original achat/assemble_url logs or SDK/HTTPX URL/body/private exception logs."
    },
    {
      "topic": "original parameter semantics",
      "fact": "create passes only model/messages/stream+extra_params, generic temperature/max_tokens/top_k not auto-forwarded; original only choices0."
    },
    {
      "topic": "original frame semantics/gap",
      "fact": "Nullable content and vendor reasoning extension supported; usage-only choices=[] valid SDK but original decoder actual IndexError. Original EOF rewrites last finish_reason stop and yields again; empty/usage-only EOF errors. Original BaseNode non-stop finish length/content_filter/tool_calls/function_call preserves OPEN_AI_REQUEST_ERROR."
    },
    {
      "topic": "error/termination",
      "fact": "SDK [DONE]/rawEOF finishes iterator without creating finish; API/SSE errors no legal choices rawframe. Do not fabricate Provider FAILED frame/DEFAULT. Only real legal frame+bound center terminal ACK can finish."
    },
    {
      "topic": "close/cancel",
      "fact": "AsyncStream.close→response.aclose; AsyncOpenAI.close→HTTPXclient.aclose. EOF fully consumed closes naturally; APIError response needs explicit close in peer probe. finally bounded double close required; local close is not Provider stop/charge-stop proof."
    }
  ],
