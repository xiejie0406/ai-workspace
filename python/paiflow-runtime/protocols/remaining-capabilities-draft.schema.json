    "CustomDatabasePayload": {
      "type": "object",
      "required": ["mode", "sql", "execDev"],
      "properties": {"mode": {"const": 0}, "sql": {"type": "string", "minLength": 1, "maxLength": 65536}, "execDev": {"type": "integer", "enum": [1, 2]}},
      "additionalProperties": false,
      "$comment": "原占位符替换后的单逻辑表SQL交中心重解析与授权，Worker不执行SQL；环境由中心派发任务固定。"
    },
