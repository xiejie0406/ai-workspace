  "x-status": "draft-not-deployed",
  "x-originalSources": {
    "plugin": [
      "core/workflow/engine/nodes/plugin_tool/plugin_node.py:get_business_input/execute",
      "core/workflow/engine/nodes/plugin_tool/link_client.py:parse_react_schema_list/Tool.assemble_parameters/assemble_body/dumps/run"
    ],
    "knowledge-pro-base": [
      "core/workflow/engine/nodes/knowledge_pro/knowledge_pro_node.py:gen_req_payload/_handle_response/execute",
      "core/workflow/engine/nodes/knowledge_pro/consts.py"
    ],
    "agent": [
      "core/workflow/engine/nodes/agent/agent_node.py:_prepare_instructions/_generate_agent_request/_normalize_tools/_process_stream_response",
      "core/agent/service/builder/workflow_agent_builder.py:_create_knowledge_tasks",
      "core/workflow/engine/nodes/util/frame_processor.py:extract_tool_calls_content"
    ],
    "database": [
      "core/workflow/engine/nodes/pgsql/pgsql_node.py:generate_dml/_build_condition/execute",
      "core/workflow/engine/nodes/pgsql/pgsql_client.py:exec_dml/payload"
    ],
    "rpa": [
      "core/workflow/engine/nodes/rpa/rpa_node.py:_StreamResponse/execute"
    ]
  },
  "x-centerRequirements": [
    "Same live run/lease/attempt + execution/begin gate + fresh platform permission + space membership + immutable node/version resource mapping",
    "Resource producer, effect ledger, approval, quota and billing persisted by center; no Worker credentials or arbitrary destinations",
    "read effectClass guarantees no charge or mutation; all charge/write calls require approved_write and center per-call approval",
    "operations and idempotency key bound to fixed resource versions, parameter hash and current run; repeat same complete request returns same ACK, different content rejects",
    "Agent dependencySelections must map each original tool/version,MCP ID,workflow ID,ordered knowledge entry to dependencyBindings and immutable authorized resources",
    "Database logical table/column/environment authorized by center; CUSTOM preserves original placeholders then sends single SQL for center reparse and logical-row evaluation (never JDBC raw SQL); ADD/UPDATE return rows within the same audited transaction; no Worker follow-up query",
    "frames cursor equals prior cursor+frame count, stable fixed resourceBindings, done only known terminal; confirmed nonzero Provider error only under FAILED/failureKind=provider",
    "Cancellation requires stopped=true; missing dispatch ACK or unconfirmed write/fee stop => EFFECT_UNKNOWN; no retries to obtain a new operation",
    "All new operations reject nested iteration until actual center iteration instance ownership exists",
    "Agent and professional RAG preserve distinct standalone producer environments; copied Agent/Link/AITools algorithms and locks do not imply these producers are restored"
  ],
  "x-originalLimits": {
    "agent": "30min total/30s connect/retry.timeout read interval; original JSON parse precedes [DONE] check, so no claimed [DONE] support; choices empty or stop supported",
    "knowledge-pro-base": "30min total/30s connect/retry.timeout interval; DeepSearch/LongRAG and AIUI-RAG2/CBG-RAG distinct; metadata resets on nonmetadata frames preserved",
    "rpa": "24h original total/30s connect; no explicit terminal marker, use center COMPLETED/done; requires fixed timeoutSeconds and stopSupported",
    "database": "mode0 CUSTOM parser/SQL translation not restored; SQLAlchemy2.0.31 original Workflow lock retained but not installed; original SQL generators preserved lazy; original output projection kept",
    "plugin": "original JSON-only body and TODO required-validation limitations retained; no arbitrary old Link schema/run URL"
  },
