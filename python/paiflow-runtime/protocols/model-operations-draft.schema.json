    },
    "ModelOperationRequest": {
      "$ref": "urn:paiflow:model-operations:v1#/$defs/ModelOperationRequest"
    },
    "ModelStartAck": {
      "$ref": "urn:paiflow:model-operations:v1#/$defs/ModelStartAck"
    },
    "ModelFramesAck": {
      "$ref": "urn:paiflow:model-operations:v1#/$defs/ModelFramesAck"
    },
    "ModelCancelAck": {
      "$ref": "urn:paiflow:model-operations:v1#/$defs/ModelCancelAck"
    },
    "StartAck": {
      "$ref": "urn:paiflow:model-operations:v1#/$defs/StartAck"
    },
    "FramesRequest": {
      "$ref": "urn:paiflow:model-operations:v1#/$defs/FramesRequest"
    },
    "FramesAck": {
      "$ref": "urn:paiflow:model-operations:v1#/$defs/FramesAck"
    },
