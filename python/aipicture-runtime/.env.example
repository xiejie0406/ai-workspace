# 默认不启动领取循环或真实模型调用。启用前使用项目已批准的 MySQL/中心/存储环境。
AIPICTURE_ENABLED=false
AIPICTURE_OFFLINE_TEST=false
AIPICTURE_SERVICE_NAME=aipicture-worker
AIPICTURE_ALLOWED_CALLER_SERVICE=aipicture-java
AIPICTURE_SERVICE_SECRET=
AIPICTURE_CENTER_URL=http://127.0.0.1:8080
AIPICTURE_API_PORT=7405
AIPICTURE_IMAGE_PROVIDER=dashscope
AIPICTURE_MATTING_PROVIDER=unconfigured
AIPICTURE_OCR_PROVIDER=unconfigured
# 原 Provider 可直接配置，不替换模型。真实增强采用原图像编辑实现，不能声称真实超分。
AIPICTURE_DASHSCOPE_API_KEY=
AIPICTURE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
AIPICTURE_TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
AIPICTURE_IMAGE_EDIT_MODEL=qwen-image-edit-max
AIPICTURE_PLANNER_MODEL=qwen-plus
# 结果下载域名须根据批准 Provider 的实际输出配置精确域名 JSON 数组，不允许任意URL。
AIPICTURE_PROVIDER_OUTPUT_HOSTS=[]
AIPICTURE_MATTING_MODEL_PATH=
AIPICTURE_SAM_ENCODER_PATH=
AIPICTURE_SAM_DECODER_PATH=
AIPICTURE_OCR_DET_MODEL_PATH=
AIPICTURE_OCR_REC_MODEL_PATH=
AIPICTURE_OCR_CLS_MODEL_PATH=
# 本机已有字体仅供本机渲染，不复制或打包分发；显式配置缺失/损坏/缺字会明确拒绝文字导出。
AIPICTURE_FONT_PATH=C:/Windows/Fonts/msyh.ttc
# 正式worker领取循环必填；填当前主机账号保护的专用绝对目录，不能放公共/profile目录。
# AIPICTURE_DELIVERY_SPOOL_DIRECTORY=<PRIVATE_ABSOLUTE_PATH>
# 本地严格超分按倍率显式配置路径和完整SHA256；未配置拒绝，不自动下载权重。
# AIPICTURE_SUPER_RESOLUTION_MODELS={"2":"<APPROVED_MODEL_ABSOLUTE_PATH>"}
# AIPICTURE_SUPER_RESOLUTION_SHA256={"2":"<SHA256>"}
# rembg 2.0.85 要求model_path位于这两个模型目录；批准资源准备后使用脚本生成的runtime.env。
# 不要以本示例空值覆盖生成的私有目录配置。
U2NET_HOME=
REMBG_HOME=
