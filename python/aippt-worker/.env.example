# 只填写该项目既有运行通道；不得连接业务数据库。
AIPPT_CENTER_URL=http://127.0.0.1:8080
AIPPT_WORKER_ID=aippt-local-worker
AIPPT_WORKER_KEY=
AIPPT_CONCURRENCY=3
AIPPT_HEARTBEAT_SECONDS=15
AIPPT_TASK_TIMEOUT_SECONDS=900

# 文本模型与图源分别授权、配置；空凭据不会产生伪造生成结果。
AIPPT_LLM_API_KEY=
AIPPT_LLM_BASE_URL=https://api.deepseek.com
AIPPT_LLM_MODEL=deepseek-v4-flash
AIPPT_LLM_THINKING_ENABLED=false
AIPPT_LLM_MAX_CALLS=8
AIPPT_LLM_MAX_OUTPUT_TOKENS=8192
AIPPT_LLM_MAX_RETRIES=2
AIPPT_TOOL_ROUNDS_MAX=4
AIPPT_REPAIR_ROUNDS_MAX=1
AIPPT_EDIT_HISTORY_MAX=5
# 生图/图库独立默认关闭；还须中心任务 image_enabled 严格为 true 才调用。
AIPPT_IMAGE_ENABLED=false
AIPPT_IMAGE_PROVIDER=openai
AIPPT_IMAGE_API_KEY=
AIPPT_IMAGE_BASE_URL=https://api.openai.com/v1
AIPPT_IMAGE_MODEL=gpt-image-1
AIPPT_IMAGE_WORKSPACE_ID=
AIPPT_UNSPLASH_ACCESS_KEY=
# 建议生产必须配置精确批准域名；使用JSON数组。空清单仍拒绝全部非公网地址。
AIPPT_OUTBOUND_ALLOWED_HOSTS=[]
# catalog目录及其上层catalog-manifest.json必须一起提供。字体须经许可准备。
# AIPPT_CATALOG_DIR=/app/contracts/aippt/catalog
# AIPPT_FONTS_DIR=/app/fonts
# AIPPT_FONT_MANIFEST_PATH=/app/fonts/manifest.json

# 禁止把材料内容发到未批准的追踪平台。
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
